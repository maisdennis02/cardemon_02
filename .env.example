# Postgres connection string. Local example:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cardemon?schema=public"
DATABASE_URL=

# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Vercel Blob token (Vercel dashboard -> Storage -> Blob -> .env.local)
BLOB_READ_WRITE_TOKEN=

# Base URL used to build Stripe success/cancel/return URLs.
# In production set to your public URL (e.g. https://menulala.com).
APP_URL=http://localhost:3000

# Stripe — create the Product in the Stripe dashboard, then create four
# recurring Prices (USD $4/mo + $35/yr, BRL R$20/mo + R$160/yr) and paste
# their IDs below. Currency is chosen at checkout from the user's locale:
# pt-BR → BRL, everything else → USD.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_ANNUAL=
STRIPE_PRICE_ID_MONTHLY_BRL=
STRIPE_PRICE_ID_ANNUAL_BRL=

# REQUIRED. The Product id (prod_...) from that same dashboard Product. The
# webhook endpoint receives every event for every product on the Stripe
# account, so it refuses to touch a user's Pro state unless the subscription
# belongs to a product listed here. Comma-separate if your test-mode Prices
# live on a different Product than the live ones:
#   STRIPE_PRODUCT_ID=prod_live123,prod_test456
# Leaving this empty makes the webhook fail with a 500 (Stripe will retry) —
# it deliberately does not fall back to accepting everything.
STRIPE_PRODUCT_ID=

# Resend — used to send password-reset emails. Create an API key at
# https://resend.com/api-keys. EMAIL_FROM must be a verified sender on the
# domain configured in Resend. If RESEND_API_KEY is empty (dev), the reset
# flow still works — the email body is logged to the server console.
RESEND_API_KEY=
EMAIL_FROM=menulala <no-reply@menulala.com>
