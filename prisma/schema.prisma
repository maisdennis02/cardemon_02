generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  emailVerified DateTime?
  name          String?
  passwordHash  String?
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Billing — `proExpiresAt` is the source of truth for plan state:
  // user is PRO while now < proExpiresAt, FREE otherwise. The other fields
  // hold the active subscription identifiers from the payment processor.
  proExpiresAt           DateTime?
  billingCycle           BillingCycle?
  billingCustomerId      String?       @unique
  billingSubscriptionId  String?       @unique

  accounts      Account[]
  sessions      Session[]
  restaurants   Restaurant[]
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Restaurant {
  id              String      @id @default(cuid())
  ownerId         String
  name            String
  slug            String      @unique
  description     String?
  whatsappNumber  String?     // digits only, e.g. "5513996332974"
  instagramUrl    String?     // full URL, e.g. "https://instagram.com/handle"
  country         String?     @db.Char(2)   // ISO-3166-1 alpha-2, e.g. "BR"
  ifoodUrl        String?
  ubereatsUrl     String?
  doordashUrl     String?
  rappiUrl        String?
  grubhubUrl      String?
  pedidosyaUrl    String?
  didifoodUrl     String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  owner           User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  images          MenuImage[]
  views           MenuView[]

  @@index([ownerId])
}

model MenuImage {
  id           String     @id @default(cuid())
  restaurantId String
  url          String
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())

  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
}

model MenuView {
  id           String     @id @default(cuid())
  restaurantId String
  viewedAt     DateTime   @default(now())
  country      String?    @db.Char(2)

  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, viewedAt])
}
